{
  "name": "@humanagencyp/files-mcp",
  "version": "0.1.2",
  "description": "Files MCP server for the Human Agency Protocol — saves files from a shared folder so an AI can name them (never handle their bytes)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanagencyprotocol/hap-files-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "files-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "homepage": "https://humanagencyprotocol.org"
}
